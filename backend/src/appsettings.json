{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "LoginApi",
    "Audience": "LoginApiUsers",
    "SecretKey": "REPLACE_WITH_SECRET_IN_ENV_OR_USER_SECRETS",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryHours": 8
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=loginapi.db"
  }
}
